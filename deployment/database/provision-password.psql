-- Administrative provisioning only; never a versioned domain migration.
-- All callers connect to postgres and use this same transaction lock. Commands
-- are read from this file; \password reads its secret separately from stdin.
-- The state query needs a fresh snapshot after a competing initializer commits.
BEGIN ISOLATION LEVEL READ COMMITTED;
SET LOCAL lock_timeout = '30s';
SET LOCAL password_encryption = 'scram-sha-256';
SELECT pg_advisory_xact_lock(1877347689, 4);
-- ON_ERROR_STOP makes a missing role (zero rows for \gset) abort the transaction.
SELECT rolpassword IS NULL AS password_unset
FROM pg_authid WHERE rolname = :'role'
\gset
\if :password_unset
\password :role
\endif
COMMIT;
