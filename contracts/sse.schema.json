{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.local/contracts/sse/v1",
  "title": "Mimir SSE typed JSON data",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.snapshot"
        },
        "snapshot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event",
        "snapshot_sequence",
        "text",
        "status"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.started"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "message.delta"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event",
        "sequence",
        "text"
      ],
      "additionalProperties": false,
      "description": "Contiguous text-only sequence; first delta after snapshot must be snapshot_sequence+1."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.usage"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.completed"
        },
        "final_text": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event",
        "final_text"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.failed"
        },
        "error_code": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event",
        "error_code"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.cancelled"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_version": {
          "const": 1
        },
        "event": {
          "const": "run.interrupted"
        }
      },
      "required": [
        "run_id",
        "event_version",
        "event"
      ],
      "additionalProperties": false,
      "description": "Control event; does not consume contiguous message.delta text sequence."
    }
  ],
  "$defs": {}
}
